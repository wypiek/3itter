{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "3itter",
  "version": "1.0.0",
  "identifier": "io.github.wypiek.itter",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "3itter",
        "width": 420,
        "height": 860,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "SocialNetworking",
    "shortDescription": "3itter: Material 3 Twitter",
    "longDescription": "Connect to any 3itter instance: a small, federated social network built with Material 3 Expressive.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
