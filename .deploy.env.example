# Copy to .deploy.env (gitignored) and fill in. Used by ./deploy.sh.
DEPLOY_HOST=203.0.113.10          # the server's address (behind Cloudflare: never commit the real one)
DEPLOY_USER=opc                   # SSH user with passwordless sudo
DEPLOY_KEY=~/.ssh/id_ed25519      # SSH private key (optional if your ssh config already has one)
DEPLOY_URL=https://example.social # public address, checked after deploying (optional)
# Defaults, change if your server differs:
# DEPLOY_DIR=/opt/orbit           # code
# DEPLOY_DATA=/var/lib/orbit      # database and uploads (never modified by deploys)
# DEPLOY_SERVICE=orbit.service
# DEPLOY_BACKUPS=3itter-backups   # in the SSH user's home
# DEPLOY_KEEP=10                  # backups of each kind to keep
